<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <springProfile name="!test">
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
      <encoder>
        <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level [%X{requestId:-} | %X{userId:-} | %X{tenantId:-}] %logger{36} - %msg%n</pattern>
        <charset>UTF-8</charset>
      </encoder>
    </appender>
    <root level="INFO"><appender-ref ref="CONSOLE"/></root>
    <logger name="com.joylin.waterkb" level="DEBUG"/>
    <logger name="org.springframework.ai" level="INFO"/>
  </springProfile>
  <springProfile name="test">
    <root level="WARN"/>
  </springProfile>
</configuration>
